{
  "name": "anything",
  "private": true,
  "version": "1.0.0",
  "description": "Anything — Professional Creative & Productivity Ecosystem Desktop Suite",
  "author": "Burhanuddin",
  "type": "module",
  "main": "electron-dist/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"electron .\"",
    "build:vite": "vite build",
    "build:electron": "node -e \"require('fs').mkdirSync('electron-dist',{recursive:true});require('fs').writeFileSync('electron-dist/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\" && tsc -p tsconfig.electron.json",
    "collect-releases": "node scripts/collect-releases.cjs",
    "collect-releases:watch": "node scripts/collect-releases.cjs --watch",
    "build": "npm run build:vite && npm run build:electron",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --publish always",
    "release:github": "node scripts/publish-github-release.cjs",
    "release:all": "node scripts/publish-github-release.cjs --all",
    "start": "electron .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.burhanuddin.anything",
    "productName": "Anything",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "BSFrameWorks5253",
      "repo": "Anything"
    },
    "artifactName": "${productName}_${version}.${ext}",
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "public/**/*",
      "published-apps/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "public/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}_${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Anything",
      "artifactName": "${productName}_${version}.${ext}"
    }
  },
  "dependencies": {
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron-updater": "^6.3.9",
    "lucide-react": "^1.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wait-on": "^9.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
